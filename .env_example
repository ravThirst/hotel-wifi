# Django Settings
SECRET_KEY=django-insecure-key
DEBUG=True

# Timezone Configuration
TIME_ZONE=Europe/Warsaw
LANGUAGE=en-us

# PostgreSQL Database Credentials
DB_NAME=wifi-hotel
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Mikrotik Router API Settings
MIKROTIK_IP=192.168.88.1
MIKROTIK_API_USER=admin
MIKROTIK_API_PASSWORD=admin
MIKROTIK_PORT=8728

MIKROTIK_HOTSPOT_SERVER=hotspot1

# Comma-separated list of IPs or Domain names that will access this server
ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1,hotel-wifi.local

# Comma-separated list of trusted origins (Required for Django 4.0+ to prevent CSRF errors)
CSRF_TRUSTED_ORIGINS=http://192.168.1.100,http://localhost,http://hotel-wifi.local